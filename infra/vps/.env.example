# Copy to infra/vps/.env on the server (never commit). deploy.sh fills blanks with random values.
PUBLIC_HOST=1-2-3-4.sslip.io          # api.<host> and lk.<host> must resolve to this box
DASHBOARD_URL=https://parlio-dashboard.example.workers.dev

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MINIO_ROOT_PASSWORD=
PARLIO_WORKER_API_KEY=

PARLIO_ENV=dev
PARLIO_REGION=uk
PARLIO_DEMO_MODE=true
PARLIO_AUTH_MODE=dev                   # supabase = real logins (set the three lines below; dashboard needs NEXT_PUBLIC_SUPABASE_URL/ANON_KEY)
PARLIO_SUPABASE_URL=                   # https://<project-ref>.supabase.co — ES256/RS256 tokens verified via its JWKS
PARLIO_SUPABASE_JWT_SECRET=            # only needed for legacy HS256 projects (Settings → API → JWT secret)
PARLIO_PLATFORM_OWNER_EMAILS=          # JSON list, e.g. ["you@parliotec.co.uk"] — gets platform-owner staff role on first sign-in

DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
NUMBER_PROVIDER=simulated              # telnyx = buy real UK numbers from the dashboard (needs Telnyx regulatory approval + credit)
OUTBOUND_DIALER=simulated              # livekit = the assistant really places outbound calls (needs OUTBOUND_SIP_TRUNK_ID)
OUTBOUND_CALLER_ID=                    # E.164 number presented on outbound AI calls (defaults to the tenant's policy caller ID)

# Phase 5 integrations (all optional; SMS/notifications/calendar fall back to log/simulated providers)
PARLIO_VAULT_KEY=                      # generated by deploy.sh if empty; encrypts SIP passwords / OAuth tokens
PARLIO_SMS_FROM_NUMBER=                # SMS-capable Telnyx number, E.164
PARLIO_RESEND_API_KEY=
PARLIO_GOOGLE_CLIENT_ID=
PARLIO_GOOGLE_CLIENT_SECRET=
PARLIO_MICROSOFT_CLIENT_ID=
PARLIO_MICROSOFT_CLIENT_SECRET=
PARLIO_SIP_DOMAIN=                     # registrar shown to PBX customers, e.g. sip.<PUBLIC_HOST>

# Phase 12 payments (optional; defaults to simulated hosted payment pages)
PARLIO_PAYMENTS_PROVIDER=simulated     # simulated | stripe (Stripe Checkout, card entry on stripe.com only)
PARLIO_STRIPE_SECRET_KEY=              # shared with billing; sk_live_/sk_test_
PARLIO_STRIPE_PAYMENTS_WEBHOOK_SECRET= # endpoint: /v1/public/payments/webhook (falls back to PARLIO_STRIPE_WEBHOOK_SECRET)
