api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: ws://127.0.0.1:7880
redis:
  address: 127.0.0.1:6379
sip_port: 5060
rtp_port: 10000-10500
use_external_ip: true
# Tolerate mobile-network RTP gaps (default 15s dropped a live call mid-sentence).
media_timeout: 30s
media_timeout_initial: 30s
logging:
  level: info
