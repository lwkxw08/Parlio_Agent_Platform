# Copy to .env (git-ignored). Never commit real values.

# --- LiveKit (worker + API) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_dev

# --- ParlioTec ---
PARLIO_ENV=dev
PARLIO_REGION=uk
PARLIO_API_URL=http://localhost:8000
PARLIO_WORKER_API_KEY=dev-worker-key
PARLIO_REDIS_URL=redis://localhost:6379/0
PARLIO_DEMO_MODE=true

# --- Recording (LiveKit Egress -> S3-compatible; MinIO locally) ---
PARLIO_RECORDING_BUCKET=parlio-recordings
PARLIO_RECORDING_S3_ENDPOINT=http://localhost:9000
PARLIO_RECORDING_S3_REGION=eu-west-2
PARLIO_RECORDING_S3_ACCESS_KEY=
PARLIO_RECORDING_S3_SECRET_KEY=

# --- AI vendors (required for real calls / `parlio-latency --real`) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Telnyx (primary carrier) ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase Auth (email + Google OAuth). Leave blank for dev mode (seeded demo owner, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Core API auth / onboarding ---
PARLIO_AUTH_MODE=dev                      # dev | supabase
PARLIO_SUPABASE_URL=
PARLIO_SUPABASE_JWT_SECRET=               # Supabase project -> Settings -> API -> JWT secret
PARLIO_DASHBOARD_URL=http://localhost:3000
PARLIO_CORS_ORIGINS=["http://localhost:3000"]
PARLIO_GOOGLE_PLACES_API_KEY=             # optional: Google Places API (New) for business lookup
